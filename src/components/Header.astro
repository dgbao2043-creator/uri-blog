---
import Wordmark from './Wordmark.astro';
import { localePath, otherLang, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Đường dẫn tới phiên bản ngôn ngữ còn lại của trang hiện tại */
  altUrl: string;
  variant?: 'solid' | 'overlay';
  current?: 'blog' | 'about' | 'now';
}

const { lang, altUrl, variant = 'solid', current } = Astro.props;
const t = useTranslations(lang);
const alt = otherLang(lang);

const links = [
  { key: 'blog', href: localePath(lang, '/#blog'), label: t('nav.blog') },
  { key: 'about', href: localePath(lang, '/about/'), label: t('nav.about') },
  { key: 'now', href: localePath(lang, '/now/'), label: t('nav.now') },
] as const;
---

<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="site-header__inner">
    <Wordmark href={localePath(lang, '/')} />

    <nav aria-label="Main" class="site-nav">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-nav__link"
                aria-current={current === link.key ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="lang-switch" href={altUrl} hreflang={alt} lang={alt} aria-label={t('nav.switch')}>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9.5"></circle>
        <path d="M2.5 12h19M12 2.5a14.5 14.5 0 0 1 0 19M12 2.5a14.5 14.5 0 0 0 0 19"></path>
      </svg>
      <span>{alt.toUpperCase()}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 72px;
  }

  .site-header--solid .site-header__inner {
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto 0;
    color: var(--on-photo);
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
  }

  .site-header--overlay .site-header__inner {
    padding-inline: clamp(16px, 3vw, 28px);
  }

  .site-nav {
    flex: 1;
  }

  .site-nav ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color var(--t-fast) var(--ease-out);
  }

  .site-header--solid .site-nav__link:hover {
    background: var(--surface);
  }

  .site-header--overlay .site-nav__link:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .site-nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 8px;
    height: 6px;
    background: var(--sun);
    border-radius: 2px;
    transform: rotate(-1.5deg);
    z-index: -1;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }

  .site-header--solid .lang-switch {
    border: 1px solid var(--line);
  }

  .site-header--solid .lang-switch:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .site-header--overlay .lang-switch {
    background: var(--bg);
    color: var(--ink);
  }

  .site-header--overlay .lang-switch:hover {
    background: var(--sun);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0 var(--s-3);
      padding-block: var(--s-2);
    }

    .site-nav {
      order: 3;
      flex-basis: 100%;
      margin-inline: calc(var(--s-3) * -1);
    }

    .lang-switch {
      margin-left: auto;
    }
  }
</style>
