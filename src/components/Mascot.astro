---
/**
 * "Nắng" — linh vật của OK, Uri.
 * Một mặt trời nhỏ (Dương = nắng) nháy mắt: "ổn cả mà".
 * Luôn là hình trang trí (aria-hidden); tên blog nằm ở chữ bên cạnh.
 */
interface Props {
  class?: string;
}

// `rest` mang theo thuộc tính scope CSS của component cha
const { class: className, ...rest } = Astro.props;

const rayAngles = [-50, -10, 30, 70, 110, 150, 190, 230];
const rays = rayAngles.map((deg) => {
  const rad = (deg * Math.PI) / 180;
  const cx = 40;
  const cy = 44;
  return {
    x1: +(cx + Math.cos(rad) * 27).toFixed(1),
    y1: +(cy + Math.sin(rad) * 27).toFixed(1),
    x2: +(cx + Math.cos(rad) * 34).toFixed(1),
    y2: +(cy + Math.sin(rad) * 34).toFixed(1),
  };
});
---

<svg
  class:list={['mascot', className]}
  viewBox="0 0 80 80"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <!-- Tia nắng: viền mực + lõi vàng như sticker -->
  <g class="mascot__rays" stroke-linecap="round">
    {rays.map((r) => <line {...r} stroke="#121212" stroke-width="7.5" />)}
    {rays.map((r) => <line {...r} stroke="#FFC83D" stroke-width="3.8" />)}
  </g>

  <g class="mascot__head">
    <!-- Lọn tóc dựng -->
    <path
      d="M37.5 22.5c-1.5-5 0.5-9 5-10.5M41.5 22.5c1-4.5 4-6.5 8-6"
      fill="none"
      stroke="#121212"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Thân: vàng + đổ bóng + vệt sáng -->
    <circle cx="40" cy="44" r="22" fill="#FFC83D" />
    <path d="M61.3 38.3A22 22 0 0 1 30.7 63.9 26 26 0 0 0 61.3 38.3Z" fill="#F29E1F" opacity="0.45" />
    <ellipse cx="31" cy="32.5" rx="7" ry="4.2" fill="#FFF6D6" opacity="0.9" transform="rotate(-32 31 32.5)" />
    <circle cx="40" cy="44" r="22" fill="none" stroke="#121212" stroke-width="3" />

    <!-- Lông mày -->
    <path d="M26.5 33.5q5-4.5 10-1.5M45 32q5-3 9.5 0.5" fill="none" stroke="#121212" stroke-width="2.2" stroke-linecap="round" />

    <!-- Mắt trái mở to, có đốm sáng -->
    <g class="mascot__eye">
      <ellipse cx="32" cy="42.5" rx="5.6" ry="7" fill="#FFFFFF" stroke="#121212" stroke-width="2" />
      <circle cx="33.4" cy="41.2" r="3.7" fill="#121212" />
      <circle cx="34.8" cy="39.6" r="1.4" fill="#FFFFFF" />
    </g>

    <!-- Mắt phải nháy -->
    <path d="M44.5 43.5Q49.5 37.5 54.5 43.5" fill="none" stroke="#121212" stroke-width="2.8" stroke-linecap="round" />

    <!-- Má hồng -->
    <ellipse cx="26.5" cy="51" rx="3.6" ry="2.3" fill="#FF7A6B" opacity="0.6" />
    <ellipse cx="54.5" cy="50.5" rx="3.6" ry="2.3" fill="#FF7A6B" opacity="0.6" />

    <!-- Miệng cười -->
    <path d="M34.5 51.5Q41.5 61 48.5 50.8Q41.5 54.2 34.5 51.5Z" fill="#121212" stroke="#121212" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M38 55.6Q41.6 58.4 45 54.9Q41.5 56 38 55.6Z" fill="#FF7A6B" />
  </g>
</svg>

<style>
  .mascot {
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }

  .mascot__rays,
  .mascot__head {
    transform-box: view-box;
    transform-origin: 40px 44px;
    transition: transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mascot__eye {
    transform-box: view-box;
    transform-origin: 32px 42.5px;
  }

  /* Di chuột vào logo: tia nắng xoay, Nắng nghiêng đầu, mắt chớp */
  :global(a:hover) > .mascot .mascot__rays,
  :global(a:focus-visible) > .mascot .mascot__rays {
    transform: rotate(40deg);
  }

  :global(a:hover) > .mascot .mascot__head,
  :global(a:focus-visible) > .mascot .mascot__head {
    transform: rotate(-10deg) scale(1.04);
  }

  :global(a:hover) > .mascot .mascot__eye {
    animation: blink 420ms ease-in-out 200ms;
  }

  @keyframes blink {
    50% {
      transform: scaleY(0.1);
    }
  }
</style>
