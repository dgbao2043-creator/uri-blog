---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import Scribble from '../Scribble.astro';
import Mascot from '../Mascot.astro';
import { SITE } from '../../site.config';
import {
  formatDate,
  getPosts,
  localePath,
  otherLang,
  postLang,
  postUrl,
  readingTime,
  useTranslations,
} from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

const translation = (
  await getCollection(
    'blog',
    (p) => p.data.translationKey === post.data.translationKey && postLang(p) !== lang,
  )
)[0];
const altUrl = translation ? postUrl(translation) : localePath(otherLang(lang), '/');

const others = (await getPosts(lang)).filter((p) => p.id !== post.id);
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  altUrl={altUrl}
  image={post.data.cover}
  current="blog"
>
  <article class="post">
    <header class="post__head container">
      <a class="post__back" href={localePath(lang, '/#blog')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {t('post.back')}
      </a>

      <a class="badge badge--sun post__cat" href={`${localePath(lang, '/')}?topic=${post.data.category}#blog`}>
        {t(`cat.${post.data.category}`)}
      </a>
      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__lead">{post.data.description}</p>

      <div class="post__byline">
        <img src={SITE.avatarSmall} alt="" width="40" height="40" />
        <div>
          <p class="post__author">{SITE.author}</p>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
            <span class="dot" aria-hidden="true"></span>
            <span>{readingTime(post.body)} {t('post.min')}</span>
          </p>
        </div>
        {
          translation && (
            <a class="post__translation" href={postUrl(translation)} hreflang={otherLang(lang)}>
              {t('post.translation')} →
            </a>
          )
        }
      </div>
    </header>

    <figure class="post__cover container">
      <img
        src={post.data.cover}
        alt={post.data.coverAlt}
      style={`object-position: ${post.data.coverPosition}`}
        width="1600"
        height="1000"
        fetchpriority="high"
      />
    </figure>

    <div class="post__body container">
      <div class="prose">
        <Content />
      </div>

      <footer class="post__sign" aria-label="Signature">
        <p class="post__sign-name hand">
          <Mascot class="post__sign-mascot" />
          {SITE.firstName}
        </p>
        <p class="post__sign-note hand">
          <Scribble kind="arrow" class="post__sign-arrow" color="var(--ink)" width={2} />
          {t('post.thanks')}
        </p>
      </footer>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related container" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related__title">
          <span class="highlight">{t('post.related')}</span>
        </h2>
        <ul class="related__grid">
          {related.map((p) => (
            <li>
              <PostCard post={p} lang={lang} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .post__head {
    max-width: calc(820px + var(--gutter) * 2);
    padding-top: var(--s-6);
  }

  .post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .post__back:hover {
    color: var(--ink);
  }

  .post__cat {
    display: table;
    margin-top: var(--s-5);
    text-decoration: none;
  }

  .post__title {
    margin-top: var(--s-4);
    font-size: var(--fs-3xl);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .post__lead {
    margin-top: var(--s-4);
    font-size: var(--fs-md);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .post__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .post__byline img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post__author {
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .post__translation {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration-color: var(--sun);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .post__cover {
    margin-block: var(--s-7) 0;
    max-width: calc(1080px + var(--gutter) * 2);
  }

  .post__cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .post__body {
    max-width: calc(var(--prose) + var(--gutter) * 2);
    padding-top: var(--s-7);
  }

  .post__sign {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-8);
  }

  .post__sign-name {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    font-size: 3.5rem;
    line-height: 1;
    transform: rotate(-5deg);
  }

  .post__sign-mascot {
    width: 1em;
    height: 1em;
    transform: rotate(8deg);
  }

  .post__sign-note {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--s-1);
    font-size: 1.35rem;
    color: var(--ink-muted);
    padding-bottom: var(--s-2);
  }

  .post__sign-arrow {
    width: 32px;
    height: 26px;
    transform: rotate(40deg);
    margin-top: -10px;
  }

  .related {
    margin-top: var(--s-9);
    padding-top: var(--s-7);
    border-top: 1px solid var(--line);
  }

  .related__title {
    font-size: var(--fs-xl);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--s-7) var(--s-6);
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
  }

  @media (max-width: 640px) {
    .post__translation {
      margin-left: 0;
      flex-basis: 100%;
    }

    .post__cover img {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-sm);
    }
  }
</style>
