---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Scribble from '../Scribble.astro';
import { formatDate, localePath, otherLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = await getEntry('pages', `${lang}/now`);
if (!page) throw new Error(`Missing src/content/pages/${lang}/now.md`);
const { Content } = await render(page);
---

<Base lang={lang} title={page.data.title} altUrl={localePath(otherLang(lang), '/now/')} current="now">
  <div class="now container">
    <header class="now__head">
      <h1 class="now__title">
        <span class="now__title-word">
          {page.data.title}
          <Scribble kind="underline" class="now__line" />
        </span>
      </h1>
      {page.data.note && <p class="now__note hand">{page.data.note}</p>}
      {
        page.data.updated && (
          <p class="now__updated">
            <span class="now__pulse" aria-hidden="true" />
            {t('now.updated')}:{' '}
            <time datetime={page.data.updated.toISOString()}>{formatDate(page.data.updated, lang)}</time>
          </p>
        )
      }
    </header>

    <div class="prose now__body">
      <Content />
    </div>
  </div>
</Base>

<style>
  .now {
    max-width: calc(var(--prose) + var(--gutter) * 2);
    padding-top: var(--s-8);
  }

  .now__title {
    font-size: var(--fs-3xl);
    letter-spacing: -0.025em;
  }

  .now__title-word {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .now__line {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.3em;
    z-index: -1;
  }

  .now__note {
    margin-top: var(--s-4);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  .now__updated {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .now__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 0 rgba(255, 200, 61, 0.7);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(255, 200, 61, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 200, 61, 0);
    }
  }

  .now__body {
    margin-top: var(--s-7);
  }

  /* Mỗi mục h2 là một "nhãn" trong sổ tay */
  .now__body :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-7);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .now__body :global(h2)::before {
    content: '';
    width: 22px;
    height: 10px;
    border-radius: 2px;
    background: var(--sun);
    transform: rotate(-4deg);
  }

  .now__body :global(h2:first-child) {
    margin-top: 0;
  }

  .now__body :global(h2 + *) {
    margin-top: var(--s-3);
  }
</style>
