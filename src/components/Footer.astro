---
import Wordmark from './Wordmark.astro';
import Scribble from './Scribble.astro';
import { SITE } from '../site.config';
import { localePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const icons: Record<string, string> = {
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>',
  youtube:
    '<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3V9z" fill="currentColor"/>',
  threads:
    '<path d="M16.5 11.2c-.5-2.6-2.3-3.7-4.6-3.7-2.6 0-4.3 1.6-4.6 4.2M16.7 11.6c-3-.9-7 0-6.7 2.4.3 2.6 5.4 2.4 6.3-1.4.6-2.3.1-5.8-3.3-7.3C9 3.8 4.5 6 4.3 12c-.2 5.4 3 8.3 7.7 8.3 3.6 0 6.3-1.9 6.9-4.9"/>',
};

const socials = Object.entries(SITE.socials).filter(([, url]) => url);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark href={localePath(lang, '/')} size="lg" />
      <p class="hand site-footer__tagline">
        {t('site.tagline')}
        <Scribble kind="squiggle" class="site-footer__squiggle" />
      </p>
    </div>

    <nav aria-label="Footer" class="site-footer__nav">
      <a href={localePath(lang, '/#blog')}>{t('nav.blog')}</a>
      <a href={localePath(lang, '/about/')}>{t('nav.about')}</a>
      <a href={localePath(lang, '/now/')}>{t('nav.now')}</a>
      {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
    </nav>

    {
      socials.length > 0 && (
        <ul class="site-footer__socials">
          {socials.map(([name, url]) => (
            <li>
              <a href={url} aria-label={name} rel="me noopener" target="_blank">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[name] ?? ''}
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {SITE.author} · {t('footer.made')}</p>
    <a href="#top">{t('footer.top')} ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-9);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-7);
    padding-block: var(--s-7) var(--s-6);
  }

  .site-footer__tagline {
    position: relative;
    display: inline-block;
    margin-top: var(--s-2);
    font-size: 1.25rem;
    color: var(--ink-muted);
  }

  .site-footer__squiggle {
    width: 100%;
    height: 8px;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
  }

  .site-footer__nav a,
  .site-footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-weight: 500;
    font-size: var(--fs-sm);
  }

  .site-footer__nav a:hover,
  .site-footer__bottom a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .site-footer__socials {
    display: flex;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: background-color var(--t-fast) var(--ease-out);
  }

  .site-footer__socials a:hover {
    background: var(--sun);
    border-color: var(--sun);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    padding-block: var(--s-4) var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
</style>
