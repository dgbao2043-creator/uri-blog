---
import Mascot from './Mascot.astro';
import { SITE } from '../site.config';

interface Props {
  href: string;
  size?: 'md' | 'lg';
}

const { href, size = 'md' } = Astro.props;
---

<a class:list={['wordmark', `wordmark--${size}`]} href={href} aria-label={`${SITE.name} — trang chủ`}>
  <Mascot class="wordmark__mascot" />
  <span class="wordmark__ok hand">OK,</span>
  <span class="wordmark__uri hand">Uri</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 44px;
    padding-block: 6px;
    color: inherit;
    text-decoration: none;
    line-height: 1;
  }

  .wordmark__mascot {
    width: 2.5em;
    height: 2.5em;
    margin-right: 0.05em;
  }

  /* "OK," — sticker vàng, chữ mực, nghiêng như vừa dán vội */
  .wordmark__ok {
    display: inline-block;
    padding: 0.12em 0.32em 0.16em;
    border-radius: 0.28em;
    background: var(--sun);
    color: var(--ink);
    font-size: 1.45em;
    box-shadow: 0.1em 0.12em 0 var(--ink);
    transform: rotate(-6deg);
    transition: transform var(--t-base) var(--ease-out);
  }

  .wordmark__uri {
    font-size: 1.9em;
    transform: rotate(-2deg) translateY(-0.04em);
  }

  .wordmark:hover .wordmark__ok {
    transform: rotate(-2deg) translateY(-1px);
  }

  .wordmark--md {
    font-size: 1rem;
  }

  .wordmark--lg {
    font-size: 1.3rem;
  }
</style>
