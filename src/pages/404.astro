---
import Base from '../layouts/Base.astro';
import Scribble from '../components/Scribble.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('vi');
const en = useTranslations('en');
---

<Base lang="vi" title="404" altUrl="/en/">
  <div class="nf container">
    <p class="nf__code hand" aria-hidden="true">
      4<span>0<Scribble kind="circle" class="nf__circle" /></span>4
    </p>
    <h1>{t('404.title')}</h1>
    <p>{t('404.text')}</p>
    <p lang="en" class="nf__en">{en('404.title')} — {en('404.text')}</p>
    <a class="nf__btn" href="/">{t('404.home')}</a>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding-block: var(--s-9) var(--s-6);
    text-align: center;
  }

  .nf__code {
    font-size: clamp(5rem, 14vw, 9rem);
    line-height: 1;
  }

  .nf__code span {
    position: relative;
    display: inline-block;
  }

  .nf__circle {
    position: absolute;
    inset: -10% -40%;
    width: 180%;
    height: 120%;
  }

  h1 {
    font-size: var(--fs-xl);
  }

  .nf__en {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .nf__btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: var(--s-4);
    padding: 0 var(--s-6);
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }

  .nf__btn:hover {
    background: var(--sun);
    color: var(--ink);
  }
</style>
