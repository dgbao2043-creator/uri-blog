---
import type { GetStaticPaths } from 'astro';
import PostView from '../../components/views/PostView.astro';
import { getPosts, postSlug } from '../../i18n/utils';

export const getStaticPaths = (async () => {
  const posts = await getPosts('vi');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<PostView post={post} lang="vi" />
